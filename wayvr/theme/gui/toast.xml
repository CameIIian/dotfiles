<layout>
  <theme>
    <var key="color_accent" value="#D38D8B" />
    <var key="color_text" value="#FCECEB" />
    <var key="color_surface" value="#333D54" />
  </theme>

  <elements>
    <div interactable="0">
      <rectangle
        max_width="500"
        padding="16"
        flex_direction="column"
        gap="8"
        color="#333D54C0"
        border_color="~color_accent"
        border="2"
        round="8">

        <div flex_direction="row" align_items="center" gap="8">
          <sprite src="icons/bell.svg" min_width="32" min_height="32" max_width="32" max_height="32" flex_grow="1" color="~color_accent" />
          <label id="toast_title" weight="bold" size="25" padding_left="16" padding_right="16" color="~color_text"/>
        </div>

        <rectangle width="100%" height="2" color="~color_accent" />

        <div>
          <label id="toast_body" wrap="1" size="20" padding_left="16" padding_right="16" color="~color_text"/>
        </div>
      </rectangle>
    </div>
  </elements>
</layout>