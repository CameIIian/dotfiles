<layout>
  <macro name="window_button" min_width="40" min_height="40" padding="4" align_items="center" justify_content="center"
    border="2" round="8" gradient="none" />

  <macro name="window_button_icon" width="32" height="32" />

  <elements>
    <div flex_grow="1" height="48">
      <rectangle
        flex_grow="1" height="48"
        padding="8" border="2"
        round="8"
        align_items="center"
        justify_content="space_between"
        color="#333D54"
        border_color="#D38D8B"
      >
        <label id="label_title" margin_left="8" color="#FCECEB" size="22" weight="bold" />
        <div gap="4">
          <Button macro="window_button" _release="::EditToggle"
            border_color="#FFCBC833" color="#FFCBC880" color2="#FFCBC81A">
            <sprite macro="window_button_icon" src="watch/edit.svg" />
          </Button>

          <Button macro="window_button" _release="::DecorCloseWindow"
            border_color="#D38D8B33" color="#D38D8B80" color2="#D38D8B1A">
            <sprite macro="window_button_icon" src="edit/close.svg" />
          </Button>
        </div>
      </rectangle>
    </div>
  </elements>
</layout>